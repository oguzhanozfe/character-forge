# ---------------------------------------------------------------- per-machine configuration (tool paths)
config/machine.json

# ---------------------------------------------------------------- character workspaces
# Only small human-readable records may be committed: character.json, brief.md, approvals.json, gates/*.json|csv.
# Stage runs, references, renders, meshes, rigs, motions and logs are local intermediates.
characters/*/stages/
characters/*/reference/
characters/*/motions/
characters/*/gates/*.png
characters/*/gates/*.log
# Final packages are produced locally and copied into a game project by the user; never committed here.
/packages/
# Motion libraries can contain licensed clips; keep them outside git unless you own them.
motion-library/

